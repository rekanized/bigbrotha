COMPOSE_PROJECT_NAME=bigbrotha
APP_URL=https://monitor.example.com
WEB_BIND_IP=0.0.0.0
WEB_PORT=8082
MEDIAMTX_ICE_BIND_IP=0.0.0.0
MEDIAMTX_ICE_PORT=8190
MEDIAMTX_WEBRTC_LOCAL_UDP_ADDRESS=:8190
MEDIAMTX_WEBRTC_LOCAL_TCP_ADDRESS=:8190

# Optional Docker Hub image overrides for image-only deployments.
# BIGBROTHA_APP_IMAGE=rekanized/bigbrotha-app:latest
# BIGBROTHA_WEB_IMAGE=rekanized/bigbrotha-web:latest

DB_DATABASE=bigbrotha
DB_USERNAME=bigbrotha
# Required: generate a unique value, for example with `openssl rand -base64 32`.
DB_PASSWORD=

CAMERA_RECORDING_WORKER_PROCESSES=2

# Trust only your reverse proxy ranges where possible. The bundled Nginx proxy
# reaches Laravel over the private Compose network, which is covered here.
TRUSTED_PROXIES=172.16.0.0/12
