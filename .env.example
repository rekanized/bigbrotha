APP_NAME=Bigbrotha
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

TRUSTED_PROXIES=127.0.0.1,::1
WEBSITE_ALLOWED_IPS=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

FFMPEG_BINARIES=/var/www/bigbrothas/bin/ffmpeg
FFPROBE_BINARIES=/var/www/bigbrothas/bin/ffprobe
FFMPEG_TIMEOUT=3600
FFMPEG_THREADS=2
FFMPEG_TEMPORARY_DIRECTORY=/var/www/bigbrothas/storage/app/private/ffmpeg-temp
FFMPEG_STREAM_RW_TIMEOUT=10000000
FFMPEG_STREAM_PROBE_SIZE=32768
FFMPEG_STREAM_ANALYZE_DURATION=0
FFMPEG_LIVE_WALL_FPS=4
FFMPEG_LIVE_WALL_MJPEG_QUALITY=7
FFMPEG_LIVE_RELAY_FRAGMENT_DURATION=500000
CAMERA_RECORDING_QUEUE=recordings
CAMERA_RECORDING_SEGMENT_SECONDS=60
CAMERA_RECORDING_LOCK_SECONDS=180
CAMERA_RECORDING_ENSURE_WORKER=false
CAMERA_RECORDING_WORKER_SYSTEMD_SERVICE=bigbrothas-recordings-queue.service
CAMERA_RECORDING_WORKER_FALLBACK_START=false
CAMERA_MOTION_ANALYSIS_SECONDS=5
CAMERA_MOTION_ANALYSIS_FPS=3
CAMERA_MOTION_ANALYSIS_WIDTH=320

MEDIAMTX_VERSION=1.17.1
MEDIAMTX_AUTO_START=true
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_ALLOW_ORIGINS=*
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=
MEDIAMTX_WEBRTC_PUBLIC_URL=
MEDIAMTX_WEBRTC_LOCAL_UDP_ADDRESS=:8189
MEDIAMTX_WEBRTC_LOCAL_TCP_ADDRESS=:8189
MEDIAMTX_AUTH_ENABLED=true
MEDIAMTX_AUTH_CALLBACK_URL=
MEDIAMTX_AUTH_CALLBACK_SECRET=
MEDIAMTX_AUTH_TOKEN_SECRET=
MEDIAMTX_AUTH_TOKEN_TTL=180
MEDIAMTX_PUBLISHER_USER=publisher
MEDIAMTX_PUBLISHER_PASS=
MEDIAMTX_TRANSCODE_VIDEO_BITRATE=1200k
MEDIAMTX_TRANSCODE_GOP=30
