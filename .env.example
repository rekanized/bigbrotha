# Copy this file to .env; Docker Compose loads it automatically.
# Required: the exact public origin, without a trailing slash.
APP_URL=

# Required: a strong random password. Generate one with: openssl rand -hex 32
DB_PASSWORD=

# Optional: uncomment only the values you need to change.
# Use a unique stack name and free ports for multiple deployments on one host.
# COMPOSE_PROJECT_NAME=bigbrotha
# WEB_PORT=8082
# MEDIAMTX_ICE_PORT=8190
# MEDIAMTX_LIVE_CLOSE_AFTER=120s
# Repair confirmed malformed source timestamps for selected camera IDs only.
# This changes their shared source timing for live viewing and recordings.
# FFMPEG_RELAY_SOURCE_WALLCLOCK_CAMERA_IDS=12,34
# For confirmed clock jumps on fixed-rate streams, rebuild video/audio timing
# from coded packet durations. Test live playback and recordings before rollout.
# FFMPEG_RELAY_SOURCE_CLOCK_REPAIR_CAMERA_IDS=12,34
# BIGBROTHA_APP_IMAGE=rekanized/bigbrotha-app:latest
